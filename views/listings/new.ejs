<% layout("/layouts/boilerplate") -%>

       <body>
              <div class="row">
                     <div class="col-8 offset-2">
                            <br>
                            <h2>Create New Data</h2>
                            <br>
                            <form method="post" action="/listing" novalidate class="needs-validation" enctype="multipart/form-data">

                                   <div>
                                          <label for="title" class="form-label">Title:</label>
                                          <input type="text" name="listing[title]" placeholder="Enter title"
                                                 class="form-control" required>
                                          <div class="valid-feedback">
                                                 Looks good!
                                          </div>
                                   </div>

                                   <div>
                                          <label for="description" class="form-label">Description:</label>
                                          <textarea name="listing[description]" placeholder="Enter Description"
                                                 class="form-control" required></textarea>
                                          <div class="invalid-feedback">
                                                 Enter the valid description
                                          </div>

                                   </div>

                                   <div>
                                          <label for="image" class="form-label">Upload Image:</label>
                                          <input type="file" name="listing[image][url]"
                                                 class="form-control">
                                   </div>
                                   
                                   <div class="row">
                                          <div class="col-md-4">
                                                 <label for="price" class="form-label">Price:</label>
                                                 <input type="text" name="listing[price]" placeholder="Enter price"
                                                        class="form-control" required>
                                                 <div class="invalid-feedback">
                                                        Please Enter the valid price
                                                 </div>

                                          </div>

                                          <div class="col-md-8">
                                                 <label for="country" class="form-label">Country:</label>
                                                 <input type="text" name="listing[country]" placeholder="Enter country"
                                                        class="form-control" required>
                                                 <div class="invalid-feedback">
                                                        Please Enter the valid counrty name
                                                 </div>

                                          </div>
                                   </div>


                                   <div>
                                          <label for="location" class="form-label">Location:</label>
                                          <input type="text" name="listing[location]" placeholder="Enter location"
                                                 class="form-control" required>
                                          <div class="invalid-feedback">
                                                 Please Enter the valid location
                                          </div>

                                   </div>
                                   <br>
                                   <button type="submit" class="btn btn-dark btn-b" class="form-control">Add</button>
                                   <br><br>

                            </form>
                     </div>
              </div>
       </body>